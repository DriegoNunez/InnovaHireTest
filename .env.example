# --- Required in production ---------------------------------------------
# Secret used to sign staff and candidate session cookies (32+ random chars).
# Generate one with: openssl rand -base64 48
AUTH_SECRET=

# Public base URL used to build candidate exam links in invitation emails.
APP_URL=http://localhost:3000

# --- Database ------------------------------------------------------------
# Leave empty to use the embedded PGlite database stored in ./.data/pglite
# (great for local development). Set a Postgres URL for production.
# DATABASE_URL=postgres://user:password@localhost:5432/innovahire
# PGLITE_DIR=./.data/pglite

# --- First admin account (created by `npm run db:seed` if missing) -------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=System Administrator
# Set to "true" to also load the sample structural-engineering question bank.
SEED_SAMPLE_QUESTIONS=true

# --- AI grading (optional) -----------------------------------------------
# Without a key, written answers are queued for human grading only.
# With an Anthropic key the grader uses Claude; otherwise, with an OpenAI key, OpenAI.
# Set AI_GRADING_PROVIDER=anthropic or openai to choose when both keys are set.
# ANTHROPIC_API_KEY=
# AI_GRADING_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_GRADING_MODEL=gpt-5.5
# Set to "true" to keep each OpenAI grading call (candidate answers included, for at least
# 30 days) so it shows in the OpenAI dashboard under Logs > Responses, tagged with exam and
# question IDs. Leave off for real candidates unless your privacy notice covers it.
# OPENAI_STORE_RESPONSES=false
# AI_GRADING_PROVIDER=

# --- Email (optional) ----------------------------------------------------
# Without SMTP settings, invitations are recorded in the outbox and printed
# to the server log so HR can copy the link manually.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# EMAIL_FROM="INNOVA Hiring <hiring@example.com>"
